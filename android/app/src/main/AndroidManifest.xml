<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Для VpnService выделенного типа foreground-сервиса в Android нет, штатный
         путь для VPN-клиентов — specialUse. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Только для сканера QR; спрашивается прямо перед съёмкой. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Без этого с Android 11 getInstalledApplications() возвращает лишь горстку
         пакетов: система прячет чужие приложения, пока их не перечислили в
         <queries> поимённо. Перечислить нельзя — список «мимо VPN» по определению
         про любое приложение на устройстве, и заранее мы их не знаем.
         Ограничение Google Play на это разрешение нас не касается: приложение
         распространяется APK, в магазин не идёт (см. план порта). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <!-- Без камеры приложение полностью работоспособно: профиль импортируется
         из буфера, из галереи и вводом ссылки. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- enableOnBackInvokedCallback="false" — намеренно старый onBackPressed вместо
         предиктивного «назад»: у приложений с targetSdk 35+ система иначе
         перехватывает жест сама и закрывает окно, не спросив интерфейс. А спросить
         надо — «назад» у нас сперва закрывает меню разделов и возвращает на
         «Подключение» (см. __mitmBack в AppMobile.svelte).

         configChanges у Activity — чтобы поворот экрана не пересоздавал окно:
         WebView при этом грузится заново, интерфейс мигает и теряет открытый
         раздел, а состояние всё равно живёт в Go и переживать пересоздание не
         обязано. -->
    <application
        android:allowBackup="false"
        android:name=".MitmApp"
        android:label="MitM"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MitM"
        android:enableOnBackInvokedCallback="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QrScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density" />

        <service
            android:name=".TunnelService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunnel managed by the user" />
        </service>
    </application>
</manifest>
